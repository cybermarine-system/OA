+constexpr char const* kImagesName = "images";
+constexpr char const* kPooledIdxName = "pooled_patches_idx";
+constexpr char const* kPatchEmbedsName = "patch_embeds";
+constexpr std::array<char, 8> kSidecarMagic{'M', 'O', 'L', 'M', 'O', '2', 'P', 'P'};
+
+enum class SidecarDtype : uint32_t
+{
+    kINT32 = 0,
+    kHALF = 1,
+    kINT64 = 2,
+};
+
+struct SidecarArray
+{
+    SidecarDtype dtype{};
+    std::vector<int64_t> dims;
+    int64_t numBytes{0};
+};
+
+template <typename T>
+T readPod(std::ifstream& in)
+{
+    T value{};
+    in.read(reinterpret_cast<char*>(&value), sizeof(T));
+    ELLM_CHECK(in.good(), "Molmo2 sidecar truncated");
+    return value;
+}
+
+SidecarArray readArrayHeader(std::ifstream& in)
+{
+    SidecarArray arr;
+    arr.dtype = static_cast<SidecarDtype>(readPod<uint32_t>(in));
+    uint32_t const ndim = readPod<uint32_t>(in);
+    ELLM_CHECK(ndim >= 1 && ndim <= 4, "Molmo2 sidecar: bad ndim " + std::to_string(ndim));
+    int64_t volume = 1;
+    for (uint32_t i = 0; i < ndim; ++i)
+    {
+        arr.dims.push_back(readPod<int64_t>(in));
+        volume *= arr.dims.back();
+    }
+    int64_t const elemSize = arr.dtype == SidecarDtype::kHALF ? 2 : (arr.dtype == SidecarDtype::kINT32 ? 4 : 8);
+    arr.numBytes = volume * elemSize;
+    return arr;
+}
+
+std::string findImagePath(LLMGenerationRequest::Request const& req)
+{
+    for (auto const& msg : req.messages)
+    {
+        for (auto const& content : msg.contents)
+        {
+            if (content.type == "image")
+            {
+                return content.content;
+            }
+        }
+    }
+    return {};
+}
+} // namespace
+
+Molmo2ViTRunner::Molmo2ViTRunner(std::string const& engineDir, cudaStream_t stream)
+    : MultimodalRunner(engineDir, stream)
+    , mEngineDir(engineDir)
+{
+    if (!validateAndFillConfig(engineDir))
+    {
+        throw std::runtime_error("Molmo2ViTRunner::Molmo2ViTRunner(): Failed to validate and fill config");
+    }
+    if (!allocateBuffer(stream))
+    {
+        throw std::runtime_error("Molmo2ViTRunner::Molmo2ViTRunner(): Failed to allocate buffer");
+    }
+}
+
+bool Molmo2ViTRunner::validateAndFillConfig(std::string const& engineDir)
+{
+    std::string const configPath = engineDir + "/config.json";
+    std::ifstream configFileStream(configPath);
+    if (!configFileStream.is_open())
+    {
+        LOG_ERROR("Failed to open config file: %s", configPath.c_str());
+        return false;
+    }
+    Json jsonConfig;
+    try
+    {
+        jsonConfig = Json::parse(configFileStream);
+    }
+    catch (Json::parse_error const& e)
+    {
+        LOG_ERROR("Failed to parse config file with error: %s", e.what());
+        return false;
+    }
+
+    mModelType = multimodal::stringToModelType(jsonConfig["model_type"].get<std::string>());
+    if (mModelType != multimodal::ModelType::MOLMO2)
+    {
+        LOG_ERROR("Invalid model type for Molmo2ViTRunner");
+        return false;
+    }
+    mConfig.vocabSize = jsonConfig["vocab_size"].get<int32_t>();
+    mConfig.hiddenSize = jsonConfig["hidden_size"].get<int64_t>();
+    mConfig.imagePatchId = jsonConfig["image_patch_id"].get<int32_t>();
+    mConfig.imageTokenId = jsonConfig.value("image_token_id", mConfig.imagePatchId);
+    mConfig.inputSuffix = jsonConfig.value("preprocessed_input_suffix", mConfig.inputSuffix);
+
+    nvinfer1::Dims const imagesMax
+        = mVisualEngine->getProfileShape(kImagesName, 0, nvinfer1::OptProfileSelector::kMAX);
+    nvinfer1::Dims const idxMax = mVisualEngine->getProfileShape(kPooledIdxName, 0, nvinfer1::OptProfileSelector::kMAX);
+    ELLM_CHECK(imagesMax.nbDims == 4 && idxMax.nbDims == 3, "Unexpected Molmo2 visual engine input ranks");
+    mConfig.maxNumCrops = imagesMax.d[1];
+    mConfig.patchesPerCrop = imagesMax.d[2];
+    mConfig.pixelsPerPatch = imagesMax.d[3];
+    mConfig.maxNumPatches = idxMax.d[1];
+
+    ELLM_CHECK(mVisualEngine->getTensorDataType(kImagesName) == nvinfer1::DataType::kHALF,
+        "Molmo2 visual engine must take FP16 images");
+    ELLM_CHECK(mVisualEngine->getTensorDataType(kPooledIdxName) == nvinfer1::DataType::kINT64,
+        "Molmo2 visual engine must take INT64 pooled_patches_idx");
+    ELLM_CHECK(mVisualEngine->getTensorDataType(kPatchEmbedsName) == nvinfer1::DataType::kHALF,
+        "Molmo2 visual engine must produce FP16 patch_embeds");
+    return true;
+}
+
+bool Molmo2ViTRunner::allocateBuffer(cudaStream_t stream)
+{
+    mImages = rt::Tensor({1, mConfig.maxNumCrops, mConfig.patchesPerCrop, mConfig.pixelsPerPatch},
+        rt::DeviceType::kGPU, nvinfer1::DataType::kHALF, "Molmo2ViTRunner::mImages");
+    mImagesHost = rt::Tensor({1, mConfig.maxNumCrops, mConfig.patchesPerCrop, mConfig.pixelsPerPatch},
+        rt::DeviceType::kCPU, nvinfer1::DataType::kHALF, "Molmo2ViTRunner::mImagesHost");
+    mPooledIdx = rt::Tensor({1, mConfig.maxNumPatches, 4}, rt::DeviceType::kGPU, nvinfer1::DataType::kINT64,
+        "Molmo2ViTRunner::mPooledIdx");
+    mPooledIdxHost = rt::Tensor({1, mConfig.maxNumPatches, 4}, rt::DeviceType::kCPU, nvinfer1::DataType::kINT64,
+        "Molmo2ViTRunner::mPooledIdxHost");
+    mPatchEmbeds = rt::Tensor({mConfig.maxNumPatches, mConfig.hiddenSize}, rt::DeviceType::kGPU,
+        nvinfer1::DataType::kHALF, "Molmo2ViTRunner::mPatchEmbeds");
+
+    // Every image-block token gets a row: pooled patches plus column/start/end markers (at most one per patch row).
+    int64_t const maxBlockTokens = 2 * mConfig.maxNumPatches + 4 * mConfig.maxNumCrops;
+    mOutputEmbedding = rt::Tensor({maxBlockTokens, mConfig.hiddenSize}, rt::DeviceType::kGPU,
+        nvinfer1::DataType::kHALF, "Molmo2ViTRunner::mOutputEmbedding");
+
+    bool ok = mVisualContext->setTensorAddress(kImagesName, mImages.rawPointer());
+    ok &= mVisualContext->setTensorAddress(kPooledIdxName, mPooledIdx.rawPointer());
+    ok &= mVisualContext->setTensorAddress(kPatchEmbedsName, mPatchEmbeds.rawPointer());
+    if (!ok)
+    {
+        LOG_ERROR("Failed to set tensor address to the Molmo2 visual engine");
+        return false;
+    }
+
+    Json jsonConfig = Json::parse(std::ifstream(mEngineDir + "/config.json"));
+    std::filesystem::path const specialPath
+        = std::filesystem::path(mEngineDir) / jsonConfig["special_embedding_file"].get<std::string>();
+    std::vector<rt::Tensor> loaded;
+    if (!rt::safetensors::loadSafetensors(specialPath, loaded, stream) || loaded.size() != 1)
+    {
+        LOG_ERROR("Failed to load Molmo2 special embedding table from %s", specialPath.c_str());
+        return false;
+    }
+    mSpecialEmbedding = std::move(loaded[0]);
+    ELLM_CHECK(mSpecialEmbedding.getDataType() == nvinfer1::DataType::kHALF
+            && mSpecialEmbedding.getDeviceType() == rt::DeviceType::kGPU
+            && mSpecialEmbedding.getShape()[1] == mConfig.hiddenSize,
+        "Molmo2 special embedding must be an FP16 GPU tensor of shape [N, hidden]");
+    mConfig.numSpecialTokens = mSpecialEmbedding.getShape()[0];
+    return true;
+}
+
+void Molmo2ViTRunner::loadSidecar(std::string const& path, std::vector<int32_t>& inputIds, cudaStream_t stream)
+{
+    std::ifstream in(path, std::ios::binary);
+    ELLM_CHECK(in.is_open(), "Molmo2 preprocessed input not found: " + path);
+    std::array<char, 8> magic{};
+    in.read(magic.data(), magic.size());
+    ELLM_CHECK(in.good() && magic == kSidecarMagic, "Bad Molmo2 sidecar magic: " + path);
+    uint32_t const version = readPod<uint32_t>(in);
+    uint32_t const numArrays = readPod<uint32_t>(in);
+    ELLM_CHECK(version == 1 && numArrays == 3, "Unsupported Molmo2 sidecar version/layout: " + path);
+
+    SidecarArray const ids = readArrayHeader(in);
+    ELLM_CHECK(ids.dtype == SidecarDtype::kINT32 && ids.dims.size() == 1, "Molmo2 sidecar: input_ids must be int32 [L]");
+    inputIds.resize(ids.dims[0]);
+    in.read(reinterpret_cast<char*>(inputIds.data()), ids.numBytes);
+
+    SidecarArray const pix = readArrayHeader(in);
+    ELLM_CHECK(pix.dtype == SidecarDtype::kHALF && pix.dims.size() == 3 && pix.dims[1] == mConfig.patchesPerCrop
+            && pix.dims[2] == mConfig.pixelsPerPatch,
+        "Molmo2 sidecar: pixel_values must be fp16 [T, patchesPerCrop, pixelsPerPatch]");
+    mNumCrops = pix.dims[0];
+    ELLM_CHECK(mNumCrops >= 1 && mNumCrops <= mConfig.maxNumCrops,
+        "Molmo2 crop count " + std::to_string(mNumCrops) + " outside engine profile");
+    in.read(static_cast<char*>(mImagesHost.rawPointer()), pix.numBytes);
+
+    SidecarArray const pool = readArrayHeader(in);
+    ELLM_CHECK(pool.dtype == SidecarDtype::kINT64 && pool.dims.size() == 2 && pool.dims[1] == 4,
+        "Molmo2 sidecar: image_token_pooling must be int64 [P, 4]");
+    mNumPatches = pool.dims[0];
+    ELLM_CHECK(mNumPatches >= 1 && mNumPatches <= mConfig.maxNumPatches,
+        "Molmo2 pooled patch count " + std::to_string(mNumPatches) + " outside engine profile");
+    in.read(static_cast<char*>(mPooledIdxHost.rawPointer()), pool.numBytes);
+    ELLM_CHECK(in.good(), "Molmo2 sidecar truncated: " + path);
+
+    check::check(mImages.reshape({1, mNumCrops, mConfig.patchesPerCrop, mConfig.pixelsPerPatch}), "reshape failed");
+    check::check(mPooledIdx.reshape({1, mNumPatches, 4}), "reshape failed");
+    check::check(mPatchEmbeds.reshape({mNumPatches, mConfig.hiddenSize}), "reshape failed");
+    CUDA_CHECK(cudaMemcpyAsync(mImages.rawPointer(), mImagesHost.rawPointer(), pix.numBytes, cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaMemcpyAsync(
+        mPooledIdx.rawPointer(), mPooledIdxHost.rawPointer(), pool.numBytes, cudaMemcpyHostToDevice, stream));
+}
+
+bool Molmo2ViTRunner::preprocess(rt::LLMGenerationRequest const& request,
+    std::vector<std::vector<int32_t>>& batchedInputIds, [[maybe_unused]] tokenizer::Tokenizer const* tokenizer,
+    [[maybe_unused]] rt::OptionalOutputTensor mropeCosSinOut, cudaStream_t stream, bool imageOnly,
+    [[maybe_unused]] bool skipEncoderWork)
+{
+    try
+    {
+        ELLM_CHECK(request.requests.size() == 1, "Molmo2ViTRunner supports batch size 1");
+        auto const& req = request.requests[0];
+        ELLM_CHECK(req.imageBuffers.size() == 1, "EDGELLM_BAD_MEDIA_COUNT: Molmo2ViTRunner expects one image");
+        std::string const imagePath = findImagePath(req);
+        ELLM_CHECK(!imagePath.empty(), "Molmo2ViTRunner: request has no image path");
+        std::filesystem::path sidecar(imagePath);
+        sidecar.replace_extension(mConfig.inputSuffix);
+
+        std::vector<int32_t> ids;
+        loadSidecar(sidecar.string(), ids, stream);
+
+        // Build the row plan and rewrite every image-block id to the shared placeholder.
+        mCopyRuns.clear();
+        int64_t patchRow = 0;
+        int64_t blockRow = 0;
+        for (auto& id : ids)
+        {
+            if (id < mConfig.vocabSize)
+            {
+                continue;
+            }
+            bool const isPatch = id == mConfig.imagePatchId;
+            int64_t const special = static_cast<int64_t>(id) - mConfig.vocabSize;
+            ELLM_CHECK(isPatch || special < mConfig.numSpecialTokens, "Molmo2 token id out of range");
+            if (isPatch && !mCopyRuns.empty() && mCopyRuns.back().fromPatch
+                && mCopyRuns.back().dstRow + mCopyRuns.back().numRows == blockRow)
+            {
+                ++mCopyRuns.back().numRows;
+            }
+            else
+            {
+                mCopyRuns.push_back(CopyRun{isPatch, isPatch ? patchRow : special, blockRow, 1});
+            }
+            patchRow += isPatch ? 1 : 0;
+            ++blockRow;
+            id = mConfig.imageTokenId;
+        }
+        ELLM_CHECK(patchRow == mNumPatches,
+            "Molmo2: <im_patch> count " + std::to_string(patchRow) + " != pooled patches " + std::to_string(mNumPatches));
+        mNumBlockTokens = blockRow;
+        check::check(mOutputEmbedding.reshape({mNumBlockTokens, mConfig.hiddenSize}), "reshape failed");
+        mLastMediaTokenLengths = {mNumBlockTokens};
+        mMultimodalMetrics.recordRun(1, mNumBlockTokens);
+
+        if (!imageOnly)
+        {
+            batchedInputIds.emplace_back(std::move(ids));
+        }
+    }
+    catch (std::exception const& e)
+    {
+        bool const actionable = isCallerActionable(e);
+        if (!actionable)
+        {
+            LOG_ERROR("Molmo2ViTRunner::preprocess failed: %s", e.what());
+        }
+        cudaStreamSynchronize(stream);
+        if (actionable)
+        {
+            throw;
+        }
+        return false;
+    }
+    return true;
+}
+
+bool Molmo2ViTRunner::infer(cudaStream_t stream) noexcept
+{
+    if (mNumBlockTokens == 0)
+    {
+        return true;
+    }
+    {
+        TIME_STAGE(metrics::StageNames::kMULTIMODAL_PROCESSING, stream);
+        bool ok = mVisualContext->setInputShape(kImagesName, mImages.getShape().getTRTDims());
+        ok &= mVisualContext->setInputShape(kPooledIdxName, mPooledIdx.getShape().getTRTDims());
+        if (!ok || !mVisualContext->enqueueV3(stream))
+        {
+            LOG_ERROR("Molmo2 visual engine enqueue failed");
+            return false;
+        }
+
+        size_t const rowBytes = static_cast<size_t>(mConfig.hiddenSize) * sizeof(half);
+        auto* dst = static_cast<char*>(mOutputEmbedding.rawPointer());
+        auto const* patch = static_cast<char const*>(mPatchEmbeds.rawPointer());
+        auto const* special = static_cast<char const*>(mSpecialEmbedding.rawPointer());
+        for (auto const& run : mCopyRuns)
+        {
+            char const* src = (run.fromPatch ? patch : special) + run.srcRow * rowBytes;
+            if (cudaMemcpyAsync(dst + run.dstRow * rowBytes, src, run.numRows * rowBytes, cudaMemcpyDeviceToDevice,
+                    stream)
+                != cudaSuccess)
+            {
+                LOG_ERROR("Molmo2 image-block assembly copy failed");
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+} // namespace rt
+} // namespace trt_edgellm

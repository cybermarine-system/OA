+
+//! \brief Configuration for the Molmo2 vision encoder (SigLIP2 + 2x2 attention pooling + projector)
+struct Molmo2ViTConfig
+{
+    int32_t vocabSize{0};       //!< LLM text vocabulary; ids at or above it index the special embedding table
+    int64_t hiddenSize{0};      //!< LLM hidden size
+    int32_t imagePatchId{0};    //!< <im_patch> id; these positions take the next visual engine output row
+    int32_t imageTokenId{0};    //!< Placeholder id written to the LLM input for every image-block position
+    int64_t patchesPerCrop{0};  //!< ViT patches per crop (27 x 27)
+    int64_t pixelsPerPatch{0};  //!< 14 x 14 x 3
+    int64_t maxNumCrops{0};     //!< From the engine profile
+    int64_t maxNumPatches{0};   //!< Pooled tokens, from the engine profile
+    int64_t numSpecialTokens{0};
+    std::string inputSuffix{".molmo2.bin"};
+};
+
+//! \brief Runner for Molmo2.
+//!
+//! Image preprocessing (crop split, patchify, pooling indices) and tokenization come from a per-request sidecar
+//! written with the HF processor: <image path stem><inputSuffix> holding input_ids, pixel_values and
+//! image_token_pooling. All image-block tokens (start/end/col/low-res-start and patches) lie outside the LLM text
+//! vocabulary, so every one of them is emitted as imageTokenId and its embedding row is assembled here: visual
+//! features for <im_patch>, rows of the Molmo2 special-token table otherwise.
+class Molmo2ViTRunner : public MultimodalRunner
+{
+public:
+    Molmo2ViTRunner(std::string const& engineDir, cudaStream_t stream);
+
+    ~Molmo2ViTRunner() noexcept = default;
+
+    bool preprocess(rt::LLMGenerationRequest const& request, std::vector<std::vector<int32_t>>& batchedInputIds,
+        tokenizer::Tokenizer const* tokenizer, [[maybe_unused]] rt::OptionalOutputTensor mropeCosSinOut,
+        cudaStream_t stream, bool imageOnly = false, bool skipEncoderWork = false) override;
+
+    bool infer(cudaStream_t stream) noexcept override;
+
+    bool validateAndFillConfig(std::string const& engineDir) override;
+
+    bool allocateBuffer(cudaStream_t stream) override;
+
+private:
+    //! Row source for one contiguous run of image-block positions in the output embedding.
+    struct CopyRun
+    {
+        bool fromPatch{false}; //!< true: rows of mPatchEmbeds, false: one row of mSpecialEmbedding
+        int64_t srcRow{0};
+        int64_t dstRow{0};
+        int64_t numRows{0};
+    };
+
+    //! \throws std::runtime_error on a malformed or missing sidecar
+    void loadSidecar(std::string const& path, std::vector<int32_t>& inputIds, cudaStream_t stream);
+

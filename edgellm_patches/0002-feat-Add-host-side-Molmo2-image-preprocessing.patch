+struct AxisTaps
+{
+    std::vector<int64_t> i0;
+    std::vector<int64_t> i1;
+    std::vector<float> frac;
+};
+
+// PyTorch upsample_bilinear2d source index with align_corners=false, computed in float32.
+AxisTaps computeTaps(int64_t inSize, int64_t outSize)
+{
+    AxisTaps taps;
+    taps.i0.resize(outSize);
+    taps.i1.resize(outSize);
+    taps.frac.resize(outSize);
+    float const scale = static_cast<float>(inSize) / static_cast<float>(outSize);
+    for (int64_t o = 0; o < outSize; ++o)
+    {
+        float const src = std::max((static_cast<float>(o) + 0.5F) * scale - 0.5F, 0.0F);
+        int64_t const x0 = std::min(static_cast<int64_t>(src), inSize - 1);
+        taps.i0[o] = x0;
+        taps.i1[o] = std::min(x0 + 1, inSize - 1);
+        taps.frac[o] = src - static_cast<float>(x0);
+    }
+    return taps;
+}
+
+//! idx [h, w] -> [ceil(h/ph) * ceil(w/pw), ph*pw], padded with -1 split as (pad/2, pad - pad/2).
+std::vector<int64_t> arangeForPooling(
+    std::vector<int64_t> const& idx, int64_t h, int64_t w, int64_t ph, int64_t pw, int64_t& outH, int64_t& outW)
+{
+    int64_t const hPad = ph * ((h + ph - 1) / ph) - h;
+    int64_t const wPad = pw * ((w + pw - 1) / pw) - w;
+    int64_t const top = hPad / 2;
+    int64_t const left = wPad / 2;
+    outH = (h + hPad) / ph;
+    outW = (w + wPad) / pw;
+    std::vector<int64_t> out(outH * outW * ph * pw, -1);
+    for (int64_t oy = 0; oy < outH; ++oy)
+    {
+        for (int64_t ox = 0; ox < outW; ++ox)
+        {
+            for (int64_t dy = 0; dy < ph; ++dy)
+            {
+                for (int64_t dx = 0; dx < pw; ++dx)
+                {
+                    int64_t const y = oy * ph + dy - top;
+                    int64_t const x = ox * pw + dx - left;
+                    if (y >= 0 && y < h && x >= 0 && x < w)
+                    {
+                        out[((oy * outW + ox) * ph + dy) * pw + dx] = idx[y * w + x];
+                    }
+                }
+            }
+        }
+    }
+    return out;
+}
+
+//! Normalize a cropSize x cropSize window of `img` (packed HWC uint8, row stride imgW) into patch-major half crop.
+void writeCrop(std::vector<uint8_t> const& img, int64_t imgW, int64_t y0, int64_t x0, PreprocessConfig const& cfg,
+    half* dst)
+{
+    int64_t const patchesPerSide = cfg.cropSize / cfg.patchSize;
+    std::array<float, 3> scale{};
+    std::array<float, 3> shift{};
+    for (int c = 0; c < 3; ++c)
+    {
+        scale[c] = 1.0F / cfg.std[c];
+        shift[c] = cfg.mean[c];
+    }
+    for (int64_t py = 0; py < patchesPerSide; ++py)
+    {
+        for (int64_t px = 0; px < patchesPerSide; ++px)
+        {
+            half* patch = dst + (py * patchesPerSide + px) * cfg.patchSize * cfg.patchSize * 3;
+            for (int64_t dy = 0; dy < cfg.patchSize; ++dy)
+            {
+                uint8_t const* row = img.data() + ((y0 + py * cfg.patchSize + dy) * imgW + x0 + px * cfg.patchSize) * 3;
+                for (int64_t dx = 0; dx < cfg.patchSize; ++dx)
+                {
+                    for (int c = 0; c < 3; ++c)
+                    {
+                        float const v = static_cast<float>(row[dx * 3 + c]) / 255.0F;
+                        *patch++ = __float2half((v - shift[c]) * scale[c]);
+                    }
+                }
+            }
+        }
+    }
+}
+
+} // namespace
+
+std::pair<int64_t, int64_t> selectTiling(int64_t h, int64_t w, int64_t windowSize, int64_t maxCrops)
+{
+    std::vector<std::pair<int64_t, int64_t>> tilings;
+    for (int64_t i = 1; i <= maxCrops; ++i)
+    {
+        for (int64_t j = 1; j <= maxCrops; ++j)
+        {
+            if (i * j <= maxCrops)
+            {
+                tilings.emplace_back(i, j);
+            }
+        }
+    }
+    std::stable_sort(tilings.begin(), tilings.end(), [](auto const& a, auto const& b) {
+        return std::make_tuple(a.first * a.second, a.first) < std::make_tuple(b.first * b.second, b.first);
+    });
+
+    // IEEE division keeps the HF behaviour for non-positive sizes (inf/negative scales).
+    float const hf = static_cast<float>(h);
+    float const wf = static_cast<float>(w);
+    std::vector<float> required(tilings.size());
+    bool allDownscale = true;
+    for (size_t k = 0; k < tilings.size(); ++k)
+    {
+        float const sh = static_cast<float>(tilings[k].first * windowSize) / hf;
+        float const sw = static_cast<float>(tilings[k].second * windowSize) / wf;
+        required[k] = std::min(sh, sw);
+        allDownscale &= required[k] < 1.0F;
+    }
+    size_t best = 0;
+    if (allDownscale)
+    {
+        for (size_t k = 1; k < required.size(); ++k)
+        {
+            if (required[k] > required[best])
+            {
+                best = k;
+            }
+        }
+    }
+    else
+    {
+        for (auto& r : required)
+        {
+            r = r < 1.0F ? 10e9F : r;
+        }
+        for (size_t k = 1; k < required.size(); ++k)
+        {
+            if (required[k] < required[best])
+            {
+                best = k;
+            }
+        }
+    }
+    return tilings[best];
+}
+
+std::vector<uint8_t> resizeBilinearRgb(uint8_t const* src, int64_t h, int64_t w, int64_t outH, int64_t outW)
+{
+    AxisTaps const ty = computeTaps(h, outH);
+    AxisTaps const tx = computeTaps(w, outW);
+    std::vector<uint8_t> out(outH * outW * 3);
+    for (int64_t y = 0; y < outH; ++y)
+    {
+        uint8_t const* r0 = src + ty.i0[y] * w * 3;
+        uint8_t const* r1 = src + ty.i1[y] * w * 3;
+        float const ly = ty.frac[y];
+        for (int64_t x = 0; x < outW; ++x)
+        {
+            float const lx = tx.frac[x];
+            int64_t const a = tx.i0[x] * 3;
+            int64_t const b = tx.i1[x] * 3;
+            for (int c = 0; c < 3; ++c)
+            {
+                float const top = static_cast<float>(r0[a + c]) * (1.0F - lx) + static_cast<float>(r0[b + c]) * lx;
+                float const bot = static_cast<float>(r1[a + c]) * (1.0F - lx) + static_cast<float>(r1[b + c]) * lx;
+                float const v = std::nearbyint(top * (1.0F - ly) + bot * ly);
+                out[(y * outW + x) * 3 + c] = static_cast<uint8_t>(std::clamp(v, 0.0F, 255.0F));
+            }
+        }
+    }
+    return out;
+}
+
+PreprocessedImage preprocessImage(uint8_t const* rgb, int64_t h, int64_t w, PreprocessConfig const& cfg)
+{
+    ELLM_CHECK(cfg.cropSize % cfg.patchSize == 0, "Molmo2 crop size must be a multiple of the patch size");
+    int64_t const cropPatches = cfg.cropSize / cfg.patchSize;
+    int64_t const patchesPerCrop = cropPatches * cropPatches;
+    int64_t const pixelsPerCrop = patchesPerCrop * cfg.patchSize * cfg.patchSize * 3;
+    int64_t const marginPatches = cfg.overlapLeft + cfg.overlapRight;
+    int64_t const totalMarginPixels = cfg.patchSize * marginPatches;
+    int64_t const windowPatches = cropPatches - marginPatches;
+    int64_t const windowSize = windowPatches * cfg.patchSize;
+
+    auto const [tilesY, tilesX]
+        = selectTiling(h - totalMarginPixels, w - totalMarginPixels, windowSize, cfg.maxCrops);
+    int64_t const srcH = tilesY * windowSize + totalMarginPixels;
+    int64_t const srcW = tilesX * windowSize + totalMarginPixels;
+    std::vector<uint8_t> const src = resizeBilinearRgb(rgb, h, w, srcH, srcW);
+
+    PreprocessedImage out;
+    out.numCrops = 1 + tilesY * tilesX;
+    out.pixels.resize(out.numCrops * pixelsPerCrop);
+
+    std::vector<uint8_t> const global = resizeBilinearRgb(rgb, h, w, cfg.cropSize, cfg.cropSize);
+    writeCrop(global, cfg.cropSize, 0, 0, cfg, out.pixels.data());
+
+    // Patch index map over the resized source in raster order, dropping overlap margins; indices count crops
+    // after the global view.
+    int64_t const srcPatchesH = srcH / cfg.patchSize;
+    int64_t const srcPatchesW = srcW / cfg.patchSize;
+    std::vector<int64_t> patchIdx;
+    patchIdx.reserve(srcPatchesH * srcPatchesW);
+    for (int64_t i = 0; i < tilesY; ++i)
+    {
+        for (int64_t r = 0; r < cropPatches; ++r)
+        {
+            bool const rowMasked = (i != 0 && r < cfg.overlapLeft) || (i != tilesY - 1 && r >= cropPatches - cfg.overlapRight);
+            for (int64_t j = 0; j < tilesX; ++j)
+            {
+                int64_t const crop = i * tilesX + j;
+                for (int64_t q = 0; q < cropPatches; ++q)
+                {
+                    bool const colMasked
+                        = (j != 0 && q < cfg.overlapLeft) || (j != tilesX - 1 && q >= cropPatches - cfg.overlapRight);
+                    if (!rowMasked && !colMasked)
+                    {
+                        patchIdx.push_back(crop * patchesPerCrop + r * cropPatches + q + patchesPerCrop);
+                    }
+                }
+            }
+        }
+    }
+    ELLM_CHECK(static_cast<int64_t>(patchIdx.size()) == srcPatchesH * srcPatchesW,
+        "Molmo2 overlap-crop patch map size mismatch");
+    for (int64_t i = 0; i < tilesY; ++i)
+    {
+        for (int64_t j = 0; j < tilesX; ++j)
+        {
+            writeCrop(src, srcW, i * windowSize, j * windowSize, cfg,
+                out.pixels.data() + (1 + i * tilesX + j) * pixelsPerCrop);
+        }
+    }
+
+    std::vector<int64_t> globalIdx(patchesPerCrop);
+    for (int64_t k = 0; k < patchesPerCrop; ++k)
+    {
+        globalIdx[k] = k;
+    }
+    int64_t resizedH = 0;
+    int64_t resizedW = 0;
+    int64_t poolH = 0;
+    int64_t poolW = 0;
+    out.pooledIdx = arangeForPooling(globalIdx, cropPatches, cropPatches, cfg.poolH, cfg.poolW, resizedH, resizedW);
+    std::vector<int64_t> const cropPool
+        = arangeForPooling(patchIdx, srcPatchesH, srcPatchesW, cfg.poolH, cfg.poolW, poolH, poolW);
+    out.pooledIdx.insert(out.pooledIdx.end(), cropPool.begin(), cropPool.end());
+    out.grid = {resizedH, resizedW, poolH, poolW};
+
+    auto& tok = out.imageTokens;
+    tok.push_back(cfg.useSingleCropStartToken ? cfg.lowResImStartId : cfg.imStartId);
+    for (int64_t y = 0; y < resizedH; ++y)
+    {
+        tok.insert(tok.end(), resizedW, cfg.imPatchId);
+        if (cfg.useSingleCropColTokens)
+        {
+            tok.push_back(cfg.imColId);
+        }
+    }
+    tok.push_back(cfg.imEndId);
+    tok.push_back(cfg.imStartId);
+    for (int64_t y = 0; y < poolH; ++y)
+    {
+        tok.insert(tok.end(), poolW, cfg.imPatchId);
+        if (cfg.useColTokens)
+        {
+            tok.push_back(cfg.imColId);
+        }
+    }
+    tok.push_back(cfg.imEndId);
+    return out;
+}
+

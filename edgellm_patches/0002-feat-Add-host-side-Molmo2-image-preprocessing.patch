+//! Host-side Molmo2 image preprocessing parameters (HF Molmo2ImageProcessor / Molmo2Processor defaults).
+struct PreprocessConfig
+{
+    int64_t cropSize{378};
+    int64_t patchSize{14};
+    int64_t maxCrops{8};
+    int64_t overlapLeft{4};
+    int64_t overlapRight{4};
+    int64_t poolH{2};
+    int64_t poolW{2};
+    std::array<float, 3> mean{{0.5F, 0.5F, 0.5F}};
+    std::array<float, 3> std{{0.5F, 0.5F, 0.5F}};
+    bool useColTokens{true};
+    bool useSingleCropColTokens{false};
+    bool useSingleCropStartToken{true};
+    int32_t imStartId{151936};
+    int32_t imEndId{151937};
+    int32_t imPatchId{151938};
+    int32_t imColId{151939};
+    int32_t lowResImStartId{151940};
+};
+
+//! Preprocessed single image. Crop 0 is the global (low-res) view.
+struct PreprocessedImage
+{
+    int64_t numCrops{0};
+    std::vector<half> pixels;          //!< [numCrops, (cropSize/patch)^2, patch*patch*3], patch-major (dy, dx, c)
+    std::vector<int64_t> pooledIdx;    //!< [numPooled, poolH*poolW], -1 = padding
+    std::array<int64_t, 4> grid{};     //!< resized_h, resized_w, h, w after pooling
+    std::vector<int32_t> imageTokens;  //!< Token sequence that replaces one <|image|> placeholder
+};
+
+//! Overlapping-crop tiling choice; mirrors HF select_tiling (float32 arithmetic, smaller tilings win ties).
+std::pair<int64_t, int64_t> selectTiling(int64_t h, int64_t w, int64_t windowSize, int64_t maxCrops);
+
+//! Bilinear resize (align_corners=false, no antialias) of packed HWC uint8 RGB, rounded back to uint8.
+std::vector<uint8_t> resizeBilinearRgb(uint8_t const* src, int64_t h, int64_t w, int64_t outH, int64_t outW);
+
+//! Full Molmo2 image preprocessing of a packed HWC uint8 RGB image.
+PreprocessedImage preprocessImage(uint8_t const* rgb, int64_t h, int64_t w, PreprocessConfig const& cfg);
+
+} // namespace molmo2
+} // namespace rt
+} // namespace trt_edgellm

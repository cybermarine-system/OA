+Molmo2ViTRunner::PreparedInput Molmo2ViTRunner::prepareInput(
+    rt::LLMGenerationRequest const& request, tokenizer::Tokenizer const* tokenizer) const
+{
+    auto const& image = request.requests[0].imageBuffers[0];
